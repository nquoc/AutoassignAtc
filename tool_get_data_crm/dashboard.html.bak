                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Doanh Thu Tháng 8</p>
                        <h3 class="text-2xl font-black mt-2 text-emerald-400 tracking-tight" id="pctqKpiT8">0 ₫</h3>
