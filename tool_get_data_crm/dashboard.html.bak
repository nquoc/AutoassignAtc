                    <span class="text-slate-400">Nguồn:</span>
                    <span class="px-2.5 py-1 rounded-lg bg-violet-500/10 text-violet-400 border border-violet-500/20 font-semibold flex items-center gap-1.5">
                        <i class="fa-solid fa-table"></i> phancungtoanquoc (A1:M40)
                    </span>
                </div>
            </div>
