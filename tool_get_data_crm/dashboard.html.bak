<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KiotViet CRM - Dashboard Phân Tích Nhân Sự & Tỉnh Thành</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0f172a; color: #f8fafc; }
        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 1rem;
        }
        .custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.5); }
        .custom-scroll::-webkit-scrollbar-thumb { background: rgba(100, 116, 139, 0.5); border-radius: 3px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: rgba(148, 163, 184, 0.8); }
    </style>
</head>
<body class="min-h-screen flex flex-col p-4 md:p-8 custom-scroll relative">



    <!-- Top Loading Progress Bar (Glowing gradient progress bar at the very top) -->
    <div id="topProgressBar" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-blue-500 via-indigo-500 to-emerald-400 z-50 transition-all duration-150 shadow-md shadow-blue-500/40" style="width: 0%; opacity: 0;"></div>

    <!-- Top Header -->
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center shadow-lg shadow-blue-500/30">
                    <i class="fa-solid fa-chart-column text-white text-lg"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
                        KiotViet CRM Analytics
                    </h1>
                    <p class="text-xs text-slate-400 font-medium mt-0.5">
                        Thống kê tỷ lệ Impact & Hiệu suất theo Nhân sự & Tỉnh thành (Google Sheet: <span class="text-blue-400 font-semibold">DATA</span> ➔ Tab: <span class="text-emerald-400 font-semibold" id="tabNameText">tudaunam</span>)
                    </p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-3 w-full md:w-auto">
            <!-- Sync Status Badge with Live Percentage & Mini Progress Bar -->
            <div id="syncBadge" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 transition-all duration-300 shadow-sm">
                <span id="syncDot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span id="syncBadgeText">Dữ liệu Google Sheets</span>
                <div id="syncProgressTrack" class="w-16 sm:w-20 bg-slate-700/80 rounded-full h-1.5 overflow-hidden ml-1 hidden">
                    <div id="syncProgressBar" class="h-full bg-gradient-to-r from-blue-400 to-emerald-400 transition-all duration-150" style="width: 0%"></div>
                </div>
            </div>
            <button id="btnRefresh" onclick="fetchLiveOrReload()" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition shadow-sm hover:border-slate-600 active:scale-95">
                <i class="fa-solid fa-arrows-rotate text-blue-400" id="refreshIcon"></i>
                Làm mới số liệu
            </button>
        </div>
    </header>

    <!-- Module Switcher (Báo Cáo CS Impact vs Doanh Thu Phần Cứng) -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
        <div class="inline-flex p-1 bg-slate-900/90 rounded-2xl border border-slate-700/80 shadow-xl backdrop-blur-md w-full sm:w-auto">
            <button id="navImpactBtn" onclick="switchModule('impact')" class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-lg transition">
                <i class="fa-solid fa-bullseye text-amber-300"></i>
                <span>📊 CS Impact (tudaunam)</span>
            </button>
            <button id="navHardwareBtn" onclick="switchModule('hardware')" class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold text-slate-400 hover:text-white transition">
                <i class="fa-solid fa-microchip text-emerald-400"></i>
                <span>🖥️ Doanh Thu Phần Cứng (phancung)</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-semibold">Mới</span>
            </button>
            <button id="navPCTQBtn" onclick="switchModule('pctq')" class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold text-slate-400 hover:text-white transition">
                <i class="fa-solid fa-table-cells text-violet-400"></i>
                <span>📋 Phần Cứng Toàn Quốc</span>
            </button>
        </div>
        <div id="moduleQuickStats" class="text-xs text-slate-400 hidden sm:flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span id="moduleQuickStatsText">Đang xem: Báo cáo tỷ lệ Impact (Sheet: DATA ➔ tudaunam)</span>
        </div>
    </div>


    <div id="impactModuleSection">
    <!-- Interactive Multi-Dimension Filter Bar -->
    <div class="glass-card p-4 mb-8 border border-slate-700/80 bg-slate-900/80 shadow-xl backdrop-blur-md">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            
            <!-- Left: Filter Dropdowns & Month Multi-Select Pills -->
            <div class="flex flex-wrap items-center gap-3">
                <div class="flex items-center gap-2 text-xs font-bold text-slate-300 mr-1">
                    <i class="fa-solid fa-filter text-blue-400"></i>
                    <span>Bộ lọc:</span>
                </div>

                <!-- Lọc Nhiều Tháng Cùng Lúc (Multi-Select Pills) -->
                <div class="flex items-center gap-2 bg-slate-800/60 p-1.5 rounded-xl border border-slate-700/60">
                    <span class="text-xs text-slate-400 font-semibold px-1 flex items-center gap-1">
                        <i class="fa-regular fa-calendar-days text-indigo-400"></i> Tháng:
                    </span>
                    <div id="monthPillContainer" class="flex flex-wrap items-center gap-1">
                        <!-- Rendered: [Tất cả] [T5] [T6] [T7] [T8] [T9] -->
                    </div>
                </div>

                <!-- Lọc theo Ngày -->
                <div class="flex items-center gap-1.5">
                    <label class="text-xs text-slate-400 font-medium">Ngày:</label>
                    <select id="filterDay" onchange="applyFilters()" class="bg-slate-800 border border-slate-700 focus:border-blue-500 rounded-lg px-2.5 py-1.5 text-xs text-white transition focus:outline-none cursor-pointer">
                        <option value="">Tất cả ngày</option>
                    </select>
                </div>

                <!-- Lọc theo Tỉnh/Thành phố -->
                <div class="flex items-center gap-1.5">
                    <label class="text-xs text-slate-400 font-medium">Tỉnh/TP:</label>
                    <select id="filterCity" onchange="applyFilters()" class="bg-slate-800 border border-slate-700 focus:border-blue-500 rounded-lg px-2.5 py-1.5 text-xs text-white transition focus:outline-none cursor-pointer max-w-[170px] truncate">
                        <option value="">Tất cả tỉnh thành</option>
                    </select>
                </div>

                <!-- Reset Filters -->
                <button onclick="resetFilters()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs border border-slate-700 transition active:scale-95" title="Đặt lại tất cả bộ lọc">
                    <i class="fa-solid fa-arrow-rotate-left text-[11px] text-slate-400"></i>
                    <span>Đặt lại</span>
                </button>
            </div>

            <!-- Right: View Mode Toggle (4 Chế Độ: Tỷ lệ Impact % | Khối Lượng | So Sánh Tháng | So Sánh Tỉnh/TP) -->
            <div class="flex items-center gap-2 self-start lg:self-center">
                <span class="text-xs text-slate-400 font-medium mr-1">Chế độ:</span>
                <div class="inline-flex rounded-xl bg-slate-800/90 p-1 border border-slate-700 flex-wrap gap-1">
                    <button id="modeImpactBtn" onclick="setViewMode('impact')" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow transition flex items-center gap-1.5">
                        <i class="fa-solid fa-bullseye text-amber-300"></i>
                        <span>Tỷ Lệ Impact</span>
                    </button>
                    <button id="modeVolumeBtn" onclick="setViewMode('volume')" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white transition flex items-center gap-1.5">
                        <i class="fa-solid fa-chart-column"></i>
                        <span>Khối Lượng</span>
                    </button>
                    <button id="modeCompareBtn" onclick="setViewMode('compare')" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white transition flex items-center gap-1.5">
                        <i class="fa-solid fa-chart-line text-emerald-400"></i>
                        <span>So Sánh Tháng</span>
                    </button>
                    <button id="modeCityBtn" onclick="setViewMode('city')" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white transition flex items-center gap-1.5">
                        <i class="fa-solid fa-map-location-dot text-sky-400"></i>
                        <span>So Sánh Tỉnh/TP</span>
                    </button>
                </div>
            </div>

        </div>

        <!-- Filter Active Summary & Impact Stats banner -->
        <div id="filterSummaryBar" class="mt-3 pt-3 border-t border-slate-800/80 flex flex-wrap items-center justify-between text-xs text-slate-400 gap-2">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span id="filterSummaryText">Đang hiển thị toàn bộ 8.979 dòng dữ liệu hợp lệ</span>
            </div>
            <div class="flex items-center gap-4 text-xs font-medium">
                <span><i class="fa-solid fa-circle-check text-emerald-400"></i> Có Impact (1): <strong class="text-emerald-300 font-bold" id="bannerImpact1">5.907</strong></span>
                <span><i class="fa-solid fa-circle-xmark text-rose-400"></i> Không Impact (0): <strong class="text-rose-300 font-bold" id="bannerImpact0">3.072</strong></span>
                <span><i class="fa-solid fa-bolt text-amber-400"></i> Tỷ Lệ: <strong class="text-amber-300 font-bold" id="bannerImpactRate">65.8%</strong></span>
            </div>
        </div>
    </div>

    <!-- KPI Summary Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <!-- Card 1: Total Rows -->
        <div class="glass-card p-5 relative overflow-hidden group hover:border-blue-500/40 transition duration-300">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400" id="kpiCard1Title">Tổng Số Dòng</p>
                    <h3 class="text-3xl font-black mt-2 text-white" id="kpiTotalRows">...</h3>
                </div>
                <div class="w-11 h-11 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center text-lg border border-blue-500/20">
                    <i class="fa-solid fa-database"></i>
                </div>
            </div>
            <p class="text-xs text-slate-400 mt-3 flex items-center gap-1" id="kpiTotalRowsSub">
                <i class="fa-solid fa-circle-check text-emerald-400"></i> Dòng hợp lệ sau lọc
            </p>
        </div>

        <!-- Card 2: Impact 1 / Staff / Latest Month / City count -->
        <div class="glass-card p-5 relative overflow-hidden group hover:border-emerald-500/40 transition duration-300">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400" id="kpiCard2Title">Có Impact (Số 1)</p>
                    <h3 class="text-3xl font-black mt-2 text-emerald-400" id="kpiCard2Val">...</h3>
                </div>
                <div class="w-11 h-11 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-lg border border-emerald-500/20" id="kpiCard2IconBox">
                    <i class="fa-solid fa-circle-check" id="kpiCard2Icon"></i>
                </div>
            </div>
            <p class="text-xs text-slate-400 mt-3 flex items-center gap-1" id="kpiCard2Sub">
                <i class="fa-solid fa-check text-emerald-400"></i> Đạt hiệu quả tích cực
            </p>
        </div>

        <!-- Card 3: Impact 0 / Top Performer / Baseline Month / Top City -->
        <div class="glass-card p-5 relative overflow-hidden group hover:border-rose-500/40 transition duration-300">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400" id="kpiCard3Title">Không Impact (Số 0)</p>
                    <h3 class="text-3xl font-black mt-2 text-rose-400" id="kpiCard3Val">...</h3>
                </div>
                <div class="w-11 h-11 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center text-lg border border-rose-500/20" id="kpiCard3IconBox">
                    <i class="fa-solid fa-circle-xmark text-rose-400" id="kpiCard3Icon"></i>
                </div>
            </div>
            <p class="text-xs text-slate-400 mt-3 flex items-center gap-1" id="kpiCard3Sub">
                <i class="fa-solid fa-triangle-exclamation text-rose-400"></i> Chưa tạo impact
            </p>
        </div>

        <!-- Card 4: Team Rate / Avg / MoM Trend / City Average -->
        <div class="glass-card p-5 relative overflow-hidden group hover:border-amber-500/40 transition duration-300">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400" id="kpiCard4Title">Tỷ Lệ Impact Toàn Team</p>
                    <h3 class="text-3xl font-black mt-2 text-amber-300" id="kpiCard4Val">...</h3>
                </div>
                <div class="w-11 h-11 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-lg border border-amber-500/20" id="kpiCard4IconBox">
                    <i class="fa-solid fa-bullseye text-amber-400" id="kpiCard4Icon"></i>
                </div>
            </div>
            <p class="text-xs text-slate-400 mt-3 flex items-center gap-1" id="kpiCard4Sub">
                <i class="fa-solid fa-award text-amber-400"></i> Top 1: Nguyễn Tiến Dũng (77.6%)
            </p>
        </div>
    </div>

    <!-- Charts & Table Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
        
        <!-- Left: Chart Card (7 cols) -->
        <div class="lg:col-span-7 glass-card p-6 flex flex-col">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                <div>
                    <h2 class="text-lg font-bold text-white flex items-center gap-2" id="chartMainTitle">
                        <i class="fa-solid fa-bullseye text-blue-400" id="chartTitleIcon"></i>
                        <span id="chartTitleText">Tỷ Lệ Impact (%) Theo Nhân Sự</span>
                    </h2>
                    <p class="text-xs text-slate-400 mt-0.5" id="chartSubTitle">So sánh % công việc thành công (impact = 1) giữa các nhân sự</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <!-- Sort Toggle -->
                    <div class="flex items-center gap-1 bg-slate-800/80 p-1 rounded-xl border border-slate-700/80 text-xs">
                        <button id="btnSortRate" onclick="setSortMode('rate')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-indigo-600 text-white transition">% Impact</button>
                        <button id="btnSortVolume" onclick="setSortMode('volume')" class="px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition">Số Dòng</button>
                    </div>
                    <!-- Type Toggle -->
                    <div class="flex items-center gap-1 bg-slate-800/80 p-1 rounded-xl border border-slate-700/80 text-xs">
                        <button id="btnBarChart" onclick="setChartType('bar')" class="px-3 py-1 rounded-lg text-xs font-semibold bg-blue-600 text-white transition">Cột</button>
                        <button id="btnSecondaryChart" onclick="setChartType('secondary')" class="px-3 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition">Tròn</button>
                    </div>
                </div>
            </div>

            <!-- Canvas Container -->
            <div class="relative flex-1 min-h-[420px] w-full flex items-center justify-center">
                <canvas id="staffChart"></canvas>
            </div>
            
            <!-- Chart Legend Guide -->
            <div id="chartLegendGuide" class="mt-4 pt-3 border-t border-slate-800/80 flex flex-wrap items-center justify-center gap-4 text-[11px] text-slate-400">
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span> Xuất sắc (≥ 75%)</span>
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span> Tốt (60 - 74%)</span>
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span> Đạt (40 - 59%)</span>
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span> Cần cải thiện (&lt; 40%)</span>
            </div>
        </div>

        <!-- Right: Leaderboard Data Table (5 cols) -->
        <div class="lg:col-span-5 glass-card p-6 flex flex-col">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h2 class="text-lg font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-list-ol text-emerald-400" id="tableHeaderIcon"></i>
                        <span id="tableMainTitle">Bảng Xếp Hạng Tỷ Lệ Impact</span>
                    </h2>
                    <p class="text-xs text-slate-400 mt-0.5">Danh sách <span id="tableCountBadge" class="text-emerald-400 font-bold">16</span> mục theo bộ lọc</p>
                </div>
            </div>

            <!-- Search Filter Input -->
            <div class="relative mb-4">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" id="searchInput" oninput="applyFilters()" placeholder="Tìm nhanh theo tên..." 
                       class="w-full pl-9 pr-4 py-2.5 rounded-xl bg-slate-800/90 border border-slate-700/80 text-xs text-white placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition">
            </div>

            <!-- Scrollable Table -->
            <div class="flex-1 overflow-x-auto overflow-y-auto max-h-[420px] custom-scroll pr-1">
                <table class="w-full text-left text-xs whitespace-nowrap">
                    <thead class="sticky top-0 bg-slate-900/95 text-slate-400 font-semibold border-b border-slate-800 z-10 backdrop-blur-md" id="tableHead">
                        <!-- Dynamic Header (Được sinh tự động theo View Mode) -->
                    </thead>
                    <tbody id="staffTableBody" class="divide-y divide-slate-800/60 font-medium">
                        <!-- Dynamic Rows Injected by JS -->
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    </div>


    <!-- HARDWARE MODULE SECTION (Tab phancung) -->
    <div id="hardwareModuleSection" class="hidden">
        
        <!-- Hardware Interactive Filter Bar -->
        <div class="glass-card p-4 mb-8 border border-slate-700/80 bg-slate-900/80 shadow-xl backdrop-blur-md">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div class="flex flex-wrap items-center gap-3">
                    <div class="flex items-center gap-2 text-xs font-bold text-slate-300 mr-1">
                        <i class="fa-solid fa-filter text-emerald-400"></i>
                        <span>Bộ lọc Phần Cứng:</span>
                    </div>
                    <!-- Nhân sự -->
                    <div class="flex items-center gap-1.5">
                        <label class="text-xs text-slate-400 font-medium">Nhân sự:</label>
                        <select id="hwFilterStaff" onchange="applyHardwareFilters()" class="bg-slate-800 border border-slate-700 focus:border-emerald-500 rounded-lg px-2.5 py-1.5 text-xs text-white transition focus:outline-none cursor-pointer max-w-[220px] truncate">
                            <option value="">Tất cả nhân sự</option>
                        </select>
                    </div>
                    <!-- Trạng thái -->
                    <div class="flex items-center gap-1.5">
                        <label class="text-xs text-slate-400 font-medium">Trạng thái:</label>
                        <select id="hwFilterStatus" onchange="applyHardwareFilters()" class="bg-slate-800 border border-slate-700 focus:border-emerald-500 rounded-lg px-2.5 py-1.5 text-xs text-white transition focus:outline-none cursor-pointer max-w-[180px] truncate">
                            <option value="">Tất cả trạng thái</option>
                        </select>
                    </div>
                    <!-- Tìm kiếm -->
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" id="hwSearchInput" oninput="applyHardwareFilters()" placeholder="Mã HĐ, Retailer ID, Gian hàng..." class="bg-slate-800 border border-slate-700 focus:border-emerald-500 rounded-lg pl-8 pr-3 py-1.5 text-xs text-white placeholder-slate-500 transition focus:outline-none w-56">
                    </div>
                    <!-- Reset -->
                    <button onclick="resetHardwareFilters()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs border border-slate-700 transition active:scale-95" title="Đặt lại bộ lọc">
                        <i class="fa-solid fa-arrow-rotate-left text-[11px] text-slate-400"></i>
                        <span>Đặt lại</span>
                    </button>
                </div>
                <!-- Right status pills -->
                <div class="flex items-center gap-2 self-start lg:self-center text-xs">
                    <span class="text-slate-400">Nguồn:</span>
                    <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-semibold flex items-center gap-1.5">
                        <i class="fa-solid fa-table"></i> Tab 'phancung' (Cột A:J)
                    </span>
                </div>
            </div>
            <!-- Summary bar -->
