                        <button id="pctqSortT8" onclick="setPCTQSort('t8')" class="px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition">T8</button>
                        <button id="pctqSortT9" onclick="setPCTQSort('t9')" class="px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition">T9</button>
