                <div class="flex items-center gap-3 text-xs">
                    <span class="text-slate-400">Trang <span id="hwPageNum" class="text-white font-bold">1</span>/<span id="hwTotalPages" class="text-white font-bold">1</span> (<span id="hwFilteredOrdersCount" class="text-emerald-400 font-bold">187</span> đơn)</span>
                    <div class="inline-flex rounded-lg border border-slate-700 bg-slate-800 p-0.5">
                        <button onclick="changeHwPage(-1)" id="hwPrevPageBtn" class="px-2.5 py-1 text-slate-400 hover:text-white disabled:opacity-30 disabled:cursor-not-allowed">
                            <i class="fa-solid fa-chevron-left text-[11px]"></i>
                        </button>
