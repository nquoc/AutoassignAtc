                            <i class="fa-solid fa-chevron-right text-[11px]"></i>
                        </button>
                    </div>
                    <select id="hwPageSizeSelect" onchange="setHwPageSize(this.value)" class="bg-slate-800 border border-slate-700 rounded-lg px-2 py-1 text-slate-300">
