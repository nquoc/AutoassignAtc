                            <th class="py-3 px-3 text-center">Khác</th>
                            <th class="py-3 px-3 text-center cursor-pointer hover:text-amber-400" onclick="setHwStaffSort('rate')">Tỷ lệ TC (%) <i class="fa-solid fa-sort text-[10px] text-slate-500"></i></th>
                            <th class="py-3 px-4 text-right cursor-pointer hover:text-emerald-300" onclick="setHwStaffSort('revenue')">DOANH THU THÀNH CÔNG (VNĐ) <i class="fa-solid fa-sort text-[10px] text-slate-500"></i></th>
                            <th class="py-3 px-4 text-right">Tổng giá trị đơn (VNĐ)</th>
                        </tr>
                    </thead>
                    <tbody id="hwStaffTableBody" class="divide-y divide-slate-800/60 font-medium">
