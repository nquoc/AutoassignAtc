                <table class="w-full text-left text-xs whitespace-nowrap">
                    <thead class="bg-slate-900/95 text-slate-300 font-semibold border-b border-slate-700">
                        <tr>
                            <th class="py-3 px-3 text-center">#</th>
                            <th class="py-3 px-4">Nhân sự xử lý</th>
