            <div class="lg:col-span-4 glass-card p-6 flex flex-col">
                <div class="mb-4">
                    <h2 class="text-lg font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-user-tie text-indigo-400"></i>
