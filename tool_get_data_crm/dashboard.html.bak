                    </tbody>
                    <tfoot id="hwStaffTableFoot" class="bg-slate-900/90 font-bold border-t-2 border-slate-700 text-slate-200">
                        <!-- Injected by JS -->
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Bảng 2: Danh Sách Chi Tiết Đơn Hàng -->
        <div class="glass-card p-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4">
                <div>
                    <h2 class="text-lg font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-list-check text-blue-400"></i>
                        <span>BẢNG 2: Danh Sách Chi Tiết Đơn Hàng Phần Cứng</span>
