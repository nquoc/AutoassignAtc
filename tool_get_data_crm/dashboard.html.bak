                        </select>
                    </div>
                    <!-- Month pills -->
                    <div class="flex items-center gap-1.5 bg-slate-800/60 p-1.5 rounded-xl border border-slate-700/60">
                        <span class="text-xs text-slate-400 font-semibold px-1 flex items-center gap-1">
                            <i class="fa-regular fa-calendar-days text-violet-400"></i> Tháng:
                        </span>
                        <div class="flex gap-1">
                            <button id="pctqPillAll" onclick="setPCTQMonth('all')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-violet-600 text-white transition">Tất cả</button>
                            <button id="pctqPill7" onclick="setPCTQMonth('7')" class="px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition">T7</button>
                            <button id="pctqPill8" onclick="setPCTQMonth('8')" class="px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition">T8</button>
                            <button id="pctqPill9" onclick="setPCTQMonth('9')" class="px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition">T9</button>
                        </div>
                    </div>
                    <!-- Reset -->
                    <button onclick="resetPCTQFilters()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs border border-slate-700 transition active:scale-95">
                        <i class="fa-solid fa-arrow-rotate-left text-[11px] text-slate-400"></i>
                        <span>Đặt lại</span>
                    </button>
