            </div>
        </div>

        <!-- KPI Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            <div class="glass-card p-5 hover:border-sky-500/40 transition">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Doanh Thu Tháng 7</p>
                        <h3 class="text-2xl font-black mt-2 text-sky-400 tracking-tight" id="pctqKpiT7">0 ₫</h3>
