    <!-- INLINE PRE-LOADED DATA (Fall-back tức thì khi mở không cần server) -->
    <script>
        // DỮ LIỆU KHỞI TẠO (Offline Fallback & Instant Render)
        const INITIAL_DATA = {
  "sheet_title": "DATA",
  "tab_name": "tudaunam",
  "gid": 1647379928,
