                            <th class="py-3 px-3 text-center cursor-pointer hover:text-emerald-400" onclick="setHwStaffSort('orders')">Thành công <i class="fa-solid fa-sort text-[10px] text-slate-500"></i></th>
                            <th class="py-3 px-3 text-center">Bán hàng</th>
                            <th class="py-3 px-3 text-center">Chuyển nhượng</th>
